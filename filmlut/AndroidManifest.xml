<?xml version="1.0" encoding="utf-8"?>
<!-- Film Drawer for the a7R II: shoot with a film look, converted in the background; or browse and convert. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.filmlut.app"
    android:versionCode="55"
    android:versionName="0.59">

    <uses-sdk android:minSdkVersion="10" android:targetSdkVersion="10" />

    <!-- Live view + shutter, and reading/writing photos. No network. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application android:label="@string/app_name" android:icon="@drawable/ic_launcher">
        <receiver android:name=".ExitCompletedReceiver">
            <intent-filter>
                <action android:name="com.android.server.DAConnectionManagerService.ExitCompleted" />
                <category android:name="ANDROID.INTENT.CATEGORY.DEFAULT" />
            </intent-filter>
        </receiver>
        <receiver android:name=".BootCompletedReceiver">
            <intent-filter>
                <action android:name="com.android.server.DAConnectionManagerService.BootCompleted" />
                <category android:name="ANDROID.INTENT.CATEGORY.DEFAULT" />
            </intent-filter>
        </receiver>

        <activity android:name=".MainActivity" android:label="@string/app_name" android:icon="@drawable/ic_launcher"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
